<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="142dp"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/projectColor"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_circle"/>

        <TextView
            android:id="@+id/txtProjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Q4 Product Launch"
            android:textSize="14sp"
            android:textColor="#111111"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="22sp"
            android:textColor="#999999"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressProject"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#111111"
        android:progressBackgroundTint="#EEEEEE"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/0 tasks completed"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/txtDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Sep 16"
            android:textSize="12sp"
            android:textColor="#888888"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="● ● ●   3 members"
        android:textSize="12sp"
        android:textColor="#AAAAAA"/>

</LinearLayout>
