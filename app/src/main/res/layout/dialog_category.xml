<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_category_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#DDDDDD"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCategoryDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Category"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/btnCloseCategory"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="×"
                android:textSize="26sp"
                android:textColor="#888888"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CATEGORY NAME"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>

        <EditText
            android:id="@+id/edtCategoryName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="#111111"
            android:hint="e.g. Study, Work, Personal..."
            android:background="@drawable/bg_outline"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="COLOR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>

        <GridLayout
            android:id="@+id/gridColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="8"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="ICON"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>

        <GridLayout
            android:id="@+id/gridIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="6"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="22dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#F5F5F5">

            <TextView
                android:id="@+id/txtPreviewIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="📚"
                android:textSize="19sp"
                android:background="@drawable/bg_circle"/>

            <TextView
                android:id="@+id/txtPreviewCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Category name"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtPreviewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tasks   ›"
                android:textSize="13sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveCategory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="Create"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B5B5B5"/>

    </LinearLayout>
</ScrollView>
