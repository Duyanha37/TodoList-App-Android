<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New Task"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/btnSaveTop"
            android:layout_width="45dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#AAAAAA"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/edtTaskName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Task name"
                android:singleLine="true"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:backgroundTint="#777777"/>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="20dp"
                android:gravity="top"
                android:padding="12dp"
                android:hint="Add description..."
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_card"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▢  Select date"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:background="@drawable/bg_outline"/>

                <TextView
                    android:id="@+id/btnTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:text="◷  9:00 AM"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:background="@drawable/bg_outline"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="CATEGORY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#888888"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="PROJECT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#888888"/>

            <Spinner
                android:id="@+id/spinnerProject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_outline"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="STATUS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#888888"/>

            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusTodo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Not Started"
                    android:textSize="12sp"
                    android:background="@drawable/bg_outline"/>

                <TextView
                    android:id="@+id/statusProgress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="In Progress"
                    android:textSize="12sp"
                    android:background="@drawable/bg_outline"/>

                <TextView
                    android:id="@+id/statusDone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Completed"
                    android:textSize="12sp"
                    android:background="@drawable/bg_outline"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <Button
        android:id="@+id/btnSaveTask"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="20dp"
        android:text="Save Task"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B5B5B5"/>
</LinearLayout>
